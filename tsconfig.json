{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "customConditions": ["react-native"]
  },
  "include": ["mobile/**/*.ts", "mobile/**/*.tsx", "mobile/expo-env.d.ts"],
  "exclude": ["mobile/node_modules"]
}
